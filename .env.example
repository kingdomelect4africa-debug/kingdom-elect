# Postgres connection string (Neon or any Postgres-compatible provider)
DATABASE_URI=postgresql://user:password@host/database?sslmode=require

# Optional: used for automated Neon project/branch management scripts
NEON_API_KEY=

# Public base URL of the deployed site (used in sitemap.xml, robots.txt, metadata)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
